{
	"compatibility_date": "2026-05-31",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"name": "dinh-mountain-help",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "nuidinh.help",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "1adf3bbda4f6497695a43dea08d501ed"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "nuidinh-db",
			"database_id": "6b97ee4a-aa6a-42d5-a20c-e963e35531dd"
		}
	],
	"r2_buckets": [
		{
			"binding": "R2_BUCKET",
			"bucket_name": "nuidinh-images"
		},
		{
			"binding": "GPX_BUCKET",
			"bucket_name": "nuidinh-gpx"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"images": {
		"binding": "IMAGES"
	},
	"vars": {
		"SITE_ORIGIN": "https://nuidinh.help"
	},
	"env": {
		"sandbox": {
			"name": "dinh-mountain-help-sandbox",
			"routes": [
				{
					"pattern": "sandbox.nuidinh.help",
					"custom_domain": true
				}
			],
			"kv_namespaces": [
				{
					"binding": "SESSION",
					"id": "31133c6f12b04cd39b8d98dcb107bd11"
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "nuidinh-db-sandbox",
					"database_id": "d93a388f-c896-4b7c-8a0a-74643af36f96"
				}
			],
			"r2_buckets": [
				{
					"binding": "R2_BUCKET",
					"bucket_name": "nuidinh-images-sandbox"
				}
			],
			"ai": {
				"binding": "AI"
			},
			"images": {
				"binding": "IMAGES"
			},
			"vars": {
				"SITE_ORIGIN": "https://sandbox.nuidinh.help"
			}
		}
	}
}