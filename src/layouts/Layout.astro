---
import '../styles/global.css';

import SEOHead from '../components/SEOHead.astro';

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'Kệ để bàn modular in 3D đáng yêu. Bảng pegboard bằng nhựa in 3D nhẹ, dễ thương, lắp ghép linh hoạt giúp bàn học luôn gọn gàng.',
} = Astro.props;
---

<!doctype html>
<html lang="vi">
  <head>
    <SEOHead title={title} description={description} ogImage="/images/hero-desk-setup.webp" />
  </head>
  <body>
    <div class="shell">
      <!-- Side Rails (editorial) -->
      <div class="side-rail left">
        <span class="rail-text">BlueMooon's Studio — Kệ để bàn modular in 3D</span>
      </div>
      <div class="side-rail right">
        <span class="rail-text">MMXXVI — Ho Chi Minh City</span>
      </div>
      <main id="main">
        <slot />
      </main>
    </div>
    <script src="/src/scripts/main.js"></script>
  </body>
</html>
