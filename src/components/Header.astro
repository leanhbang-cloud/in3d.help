---
// Topbar + Nav (Headroom sticky, glassmorphism)
---

<!-- Top Metadata Strip (editorial) -->
<div class="topbar">
  <div class="container">
    <div class="topbar-inner">
      <span><span class="pulse"></span> <b>BlueMoon's Studio</b></span>
      <span class="mid">
        <span>Vol. 01 / <span class="cyan">Kệ Modular Dễ Thương</span></span>
        <span>Ho Chi Minh City · 10.8231° N, 106.6297° E</span>
      </span>
      <span class="right">
        <span>v2.1 · 2026</span>
        <span>VI / EN</span>
      </span>
    </div>
  </div>
</div>

<!-- Sticky Glassmorphism Nav -->
<nav class="nav" role="navigation" aria-label="Main Navigation">
  <div class="container">
    <div class="nav-inner">
      <!-- Brand -->
      <a href="/" class="brand">
        <span class="brand-mark">BM</span>
        <span class="brand-name">BlueMoon<span class="dot">✿</span></span>
      </a>

      <!-- Links -->
      <ul class="nav-links">
        <li><a href="#san-pham">Sản phẩm</a></li>
        <li><a href="#cach-hoat-dong">Quy trình</a></li>
        <li><a href="#bo-suu-tap">Bộ sưu tập</a></li>
        <li><a href="#ve-chung-toi">Về chúng tôi</a></li>
        <li><a href="#faq">FAQ</a></li>
      </ul>

      <!-- Actions -->
      <div class="nav-actions">
        <a href="#san-pham" class="btn btn-zalo" style="padding:9px 18px; font-size:13px;">
          Đặt mua ngay
        </a>
      </div>
    </div>
  </div>
</nav>
