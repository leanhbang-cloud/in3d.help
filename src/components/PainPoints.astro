---
// Pain Points: 3 glassmorphism cards
const pains = [
  {
    icon: '😤',
    title: 'Góc bàn bừa bộn, ngột ngạt',
    desc: 'Bút viết, dây sạc, tai nghe để lung tung trên bàn học. Mỗi lần ngồi vào bàn là cảm thấy ngột ngạt, mất tập trung.',
  },
  {
    icon: '💸',
    title: 'Kệ kim loại cồng kềnh, đắt đỏ',
    desc: 'Kệ sắt hay kệ gỗ đại trà thường rất nặng, to so với bàn học sinh, giá đắt, lại dễ làm xước mặt bàn gỗ.',
  },
  {
    icon: '🎨',
    title: 'Thiếu sự tùy biến dễ thương',
    desc: 'Bạn thích trang trí góc làm việc mang chất riêng của mình, nhưng các kệ trên thị trường lại quá khô khan, góc cạnh.',
  },
];
---

<section class="tight" id="van-de">
  <div class="container">
    <div class="sec-rule">
      <span class="roman">II.</span>
      <span class="meta-grp">
        <span>Vấn đề</span>
      </span>
      <span>002 / 010</span>
    </div>

    <div class="section-header" data-reveal>
      <span class="label">Bạn đang gặp phải</span>
      <h2 class="display">
        Những <em>rắc rối</em> quen thuộc<span class="dot">✿</span>
      </h2>
    </div>

    <div class="pain-grid" data-reveal-stagger>
      {pains.map((pain) => (
        <div class="glass-card pain-card">
          <div class="icon-wrap">{pain.icon}</div>
          <h3>{pain.title}</h3>
          <p>{pain.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
