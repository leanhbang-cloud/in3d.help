---
// Pain Points: 3 glassmorphism cards
const pains = [
  {
    icon: '😤',
    title: 'Bàn học bừa bộn, dễ mất đồ',
    desc: 'Trước đây bàn học của con đầy bút vẽ, kẹp tóc, đồ chơi để lung tung. Mỗi lần ngồi vào bàn là con lại lười học vì nhìn rối mắt quá.',
  },
  {
    icon: '💸',
    title: 'Kệ sắt cồng kềnh, đắt đỏ',
    desc: 'Bố từng mua cho con kệ sắt nhưng nó nặng trịch, cạnh sắt nhọn làm trầy cả mặt bàn gỗ của con, mà nhìn lại không cute tí nào.',
  },
  {
    icon: '🎨',
    title: 'Thiếu sắc màu pastel con thích',
    desc: 'Con muốn góc bàn có màu hồng kem pastel nhẹ nhàng theo ý mình, nhưng kệ bán ở ngoài tiệm cứ thô cứng và toàn màu tối thui.',
  },
];
---

<section class="tight" id="van-de">
  <div class="container">
    <div class="sec-rule">
      <span class="roman">II.</span>
      <span class="meta-grp">
        <span>Vấn đề</span>
      </span>
      <span>002 / 010</span>
    </div>

    <div class="section-header" data-reveal>
      <span class="label">Bạn đang gặp phải</span>
      <h2 class="display">
        Những <em>rắc rối</em> quen thuộc<span class="dot">✿</span>
      </h2>
    </div>

    <div class="pain-grid" data-reveal-stagger>
      {pains.map((pain) => (
        <div class="glass-card pain-card">
          <div class="icon-wrap">{pain.icon}</div>
          <h3>{pain.title}</h3>
          <p>{pain.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
