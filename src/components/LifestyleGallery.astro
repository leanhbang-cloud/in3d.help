---
// Lifestyle Gallery: Masonry grid
const images = [
  { src: '/images/lifestyle-student-v2.webp', alt: 'Kệ pegboard modular xinh xắn cho học sinh sinh viên', tag: 'HỌC TẬP', caption: 'Góc học tập sinh viên' },
  { src: '/images/lifestyle-kids-v2.webp', alt: 'Kệ pegboard modular ngộ nghĩnh cho phòng của bé', tag: 'MẸ & BÉ', caption: 'Góc học tập cho bé' },
  { src: '/images/hero-desk-setup-v2.webp', alt: 'Kệ pegboard modular in 3D dễ thương trên bàn học gọn gàng', tag: 'SETUP #01', caption: 'Làm việc hiệu quả' },
  { src: '/images/hero-pegboard.webp', alt: 'Phối màu và phụ kiện kệ modular BlueMoon\'s Studio', tag: 'SETUP #02', caption: 'Góc học tập nhỏ' },
  { src: '/images/detail-assembly-v2.webp', alt: 'Chi tiết các khay kệ và module lắp ráp thực tế', tag: 'SETUP #03', caption: 'Góc chơi game xinh' },
  { src: '/images/detail-3dprint.webp', alt: 'Cận cảnh chất liệu nhựa in 3D hoàn thiện mịn màng của kệ', tag: 'CHẤT LIỆU', caption: 'Chi tiết in 3D sắc nét' },
];
---

<section id="bo-suu-tap">
  <div class="container">
    <div class="sec-rule">
      <span class="roman">VI.</span>
      <span class="meta-grp">
        <span>Phòng trưng bày</span>
      </span>
      <span>006 / 010</span>
    </div>

    <div class="section-header" data-reveal>
      <span class="label">Ảnh thực tế</span>
      <h2 class="display">
        Khách hàng <em>yêu thích</em><br/>setup của họ<span class="dot">.</span>
      </h2>
    </div>

    <div class="masonry" data-reveal-stagger>
      {images.map((img) => (
        <div class="masonry-item">
          <img src={img.src} alt={img.alt} loading="lazy" />
          <div class="caption">
            <span class="tag">{img.tag}</span>
            {img.caption}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
