---
// Lifestyle Gallery: Masonry grid
const images = [
  { src: '/images/lifestyle-student.webp', alt: 'Kệ pegboard modular xinh xắn cho học sinh sinh viên', tag: 'HỌC TẬP', caption: 'Góc học tập sinh viên' },
  { src: '/images/lifestyle-kids.webp', alt: 'Kệ pegboard modular ngộ nghĩnh cho phòng của bé', tag: 'MẸ & BÉ', caption: 'Góc học tập cho bé' },
  { src: '/images/gallery/desk-01.webp', alt: 'Setup bàn làm việc gọn gàng', tag: 'SETUP #01', caption: 'Làm việc hiệu quả' },
  { src: '/images/gallery/desk-02.webp', alt: 'Bàn học sinh viên ngăn nắp', tag: 'SETUP #02', caption: 'Góc học tập nhỏ' },
  { src: '/images/gallery/desk-03.webp', alt: 'Gaming setup đáng yêu với kệ', tag: 'SETUP #03', caption: 'Góc chơi game xinh' },
  { src: '/images/gallery/desk-05.webp', alt: 'Minimal desk pegboard trắng', tag: 'SETUP #04', caption: 'Góc làm việc WFH' },
];
---

<section id="bo-suu-tap">
  <div class="container">
    <div class="sec-rule">
      <span class="roman">VI.</span>
      <span class="meta-grp">
        <span>Phòng trưng bày</span>
      </span>
      <span>006 / 010</span>
    </div>

    <div class="section-header" data-reveal>
      <span class="label">Ảnh thực tế</span>
      <h2 class="display">
        Khách hàng <em>yêu thích</em><br/>setup của họ<span class="dot">.</span>
      </h2>
    </div>

    <div class="masonry" data-reveal-stagger>
      {images.map((img) => (
        <div class="masonry-item">
          <img src={img.src} alt={img.alt} loading="lazy" />
          <div class="caption">
            <span class="tag">{img.tag}</span>
            {img.caption}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
