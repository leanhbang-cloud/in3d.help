---
const faqs = [
  {
    q: 'Pegboard được in bằng chất liệu gì vậy con?',
    a: 'Dạ, tất cả kệ pegboard đều được bố con in bằng nhựa sinh học PLA+ nhập khẩu. Nhựa này làm từ bột bắp (ngô) nên cực kỳ an toàn, không có mùi nhựa hôi đâu ạ, người lớn hay trẻ con tụi con dùng đều yên tâm. Bố con cũng test độ bền rồi, chịu nhiệt tới 60°C lận nên cô chú cứ yên tâm bày trên bàn làm việc nha.',
  },
  {
    q: 'Thời gian giao hàng bao lâu con nhỉ?',
    a: 'Dạ, nội thành TP.HCM thì bố con gửi ship mất 1-2 ngày là tới nơi ạ. Các tỉnh thành khác thì từ 3-5 ngày qua bưu điện. Vì mỗi kệ đều được in mới tinh sau khi cô chú đặt nên bố con cần khoảng 1-2 ngày để chuẩn bị máy in và đóng gói nha.',
  },
  {
    q: 'Con có nhận thiết kế phụ kiện riêng không?',
    a: 'Dạ có ạ! Gói Creator Studio đã bao gồm 1 phụ kiện tự thiết kế riêng. Cô chú cũng có thể đặt riêng các móc treo, khay đựng đặc biệt khác với giá siêu nhỏ chỉ từ 50K. Cô chú cứ nhắn Zalo để bố con vẽ hình và in cho nha.',
  },
  {
    q: 'Pegboard treo tường hay đặt bàn thì được hả con?',
    a: 'Dạ, kiểu nào cũng được hết luôn! Mỗi bộ kệ bố con đều chuẩn bị sẵn chân đỡ để đặt đứng trên bàn, và cả miếng dán tường 3M siêu chắc nếu cô chú muốn treo lên tường. Rất là tiện luôn ạ!',
  },
  {
    q: 'Kệ có được bảo hành không cô bé?',
    a: 'Dạ, con và bố bảo hành lỗi sản xuất trong vòng 12 tháng cho tấm kệ chính, và 6 tháng cho phụ kiện ạ. Nếu trong lúc sử dụng bình thường mà kệ có bị nứt gãy gì, cô chú cứ chụp ảnh gửi Zalo cho con, bố con sẽ in cái mới gửi đền cho cô chú ngay ạ!',
  },
  {
    q: 'Bên mình thanh toán thế nào vậy con?',
    a: 'Dạ, cô chú có thể chuyển khoản ngân hàng cho bố con, hoặc chọn COD (tức là shipper giao hàng tới nhà cô chú kiểm tra kệ đẹp rồi mới trả tiền mặt) đều được hết ạ.',
  },
];
---

<section id="faq" aria-labelledby="faq-heading">
  <div class="container">
    <div class="sec-rule" aria-hidden="true">
      <span class="roman">VIII.</span>
      <span class="meta-grp">
        <span>Câu hỏi thường gặp</span>
      </span>
      <span>008 / 010</span>
    </div>

    <div class="section-header" data-reveal style="text-align:center;">
      <span class="label" style="justify-content:center;">FAQ</span>
      <h2 class="display" style="margin:0 auto;" id="faq-heading">
        Cô chú hỏi,<br/>con xin <em>giải đáp</em><span class="dot" aria-hidden="true">✿</span>
      </h2>
    </div>

    <div class="faq-list" data-reveal>
      {faqs.map((faq, index) => {
        const questionId = `faq-q-${index}`;
        const answerId = `faq-a-${index}`;
        return (
          <div class="faq-item">
            <button
              class="faq-question"
              aria-expanded="false"
              aria-controls={answerId}
              id={questionId}
            >
              <span>{faq.q}</span>
              <svg
                class="chevron"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </button>
            <div
              class="faq-answer-wrapper"
              id={answerId}
              role="region"
              aria-labelledby={questionId}
            >
              <div class="faq-answer-inner">
                <div class="faq-answer">
                  <p>{faq.a}</p>
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
