---
// How It Works: 4-step timeline
const steps = [
  {
    num: '01',
    icon: '✨',
    title: 'Chọn mẫu yêu thích',
    desc: 'Xem các mẫu combo kệ pegboard và phụ kiện. Chọn size, màu sắc, và phụ kiện theo phong cách của bạn.',
  },
  {
    num: '02',
    icon: '📝',
    title: 'Điền thông tin đặt hàng',
    desc: 'Nhập tên, số điện thoại, địa chỉ nhận hàng. Chọn phương thức thanh toán: chuyển khoản hoặc COD.',
  },
  {
    num: '03',
    icon: '📞',
    title: 'Xác nhận đơn hàng',
    desc: 'Chúng mình sẽ liên hệ xác nhận qua Zalo hoặc số điện thoại trong 2 giờ (giờ hành chính).',
  },
  {
    num: '04',
    icon: '🌸',
    title: 'Nhận hàng & decor thôi!',
    desc: 'Đơn hàng giao trong 3-5 ngày. Mở hộp, lắp ghép dễ dàng với chốt khóa 90° và tận hưởng góc bàn xinh!',
  },
];
---

<section id="cach-hoat-dong">
  <div class="container">
    <div class="sec-rule">
      <span class="roman">IV.</span>
      <span class="meta-grp">
        <span>Quy trình</span>
      </span>
      <span>004 / 010</span>
    </div>

    <div class="section-header" data-reveal>
      <span class="label">Mua hàng đơn giản lắm nè!</span>
      <h2 class="display">
        Chỉ 4 bước để có ngay<br/> <em>góc bàn xinh</em> đáng yêu<span class="dot">✿</span>
      </h2>
    </div>

    <div class="timeline-grid" data-reveal-stagger>
      {steps.map((step) => (
        <div class="timeline-step">
          <div class="step-num">{step.num}</div>
          <div class="step-icon">{step.icon}</div>
          <h3>{step.title}</h3>
          <p>{step.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
