---
// How It Works: 4-step timeline
const steps = [
  {
    num: '01',
    icon: '✨',
    title: 'Cô chú chọn mẫu kệ xinh',
    desc: 'Cô chú xem các combo kệ ở trên, chọn kích thước và những phụ kiện cute đi kèm theo ý thích nha.',
  },
  {
    num: '02',
    icon: '📝',
    title: 'Nhắn tin Zalo cho con',
    desc: 'Cô chú bấm nút chat Zalo bên dưới để gửi thông tin cho con và bố chuẩn bị đơn hàng ạ.',
  },
  {
    num: '03',
    icon: '📞',
    title: 'Bố con chuẩn bị máy in',
    desc: 'Bố con sẽ bắt đầu vận hành máy in 3D thật cẩn thận để in những chiếc kệ đẹp nhất, đóng gói gửi đi.',
  },
  {
    num: '04',
    icon: '🌸',
    title: 'Nhận kệ và khoe bàn xinh!',
    desc: 'Sau 3-5 ngày, shipper giao tới, cô chú mở hộp lắp ghép cực dễ luôn rồi khoe góc bàn mới với con nha.',
  },
];
---

<section id="cach-hoat-dong">
  <div class="container">
    <div class="sec-rule">
      <span class="roman">IV.</span>
      <span class="meta-grp">
        <span>Quy trình</span>
      </span>
      <span>004 / 010</span>
    </div>

    <div class="section-header" data-reveal>
      <span class="label">Mua hàng đơn giản lắm nè!</span>
      <h2 class="display">
        Chỉ 4 bước để có ngay<br/> <em>góc bàn xinh</em> đáng yêu<span class="dot">✿</span>
      </h2>
    </div>

    <div class="timeline-grid" data-reveal-stagger>
      {steps.map((step) => (
        <div class="timeline-step">
          <div class="step-num">{step.num}</div>
          <div class="step-icon">{step.icon}</div>
          <h3>{step.title}</h3>
          <p>{step.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
